# Reference only: Spring Boot does not load this file automatically.
# Copy it to .env (ignored by Git), fill in real values and export them in your
# shell, or let Docker Compose interpolate them. Never commit real values.

# PostgreSQL (docker-compose.iam.yml publishes it on host port 5433)
DB_URL=jdbc:postgresql://localhost:5433/foodly_iam
DB_USERNAME=foodly_iam
DB_PASSWORD=

# JWT signing key: standard Base64 of at least 32 random bytes (HS256).
# Generate one with: openssl rand -base64 32
# Business must receive the very same value as IAM_JWT_SECRET_BASE64.
JWT_SECRET_BASE64=

# Value of the "iss" claim. Business expects it in IAM_JWT_ISSUER.
JWT_ISSUER=foodly-iam

# Comma-separated values of the "aud" claim. Must include foodly-iam, because
# IAM validates its own tokens against it. Business expects foodly-business.
JWT_AUDIENCES=foodly-iam,foodly-business,foodly-radar,foodly-messaging,foodly-reservation,foodly-community

# Port map of the project: Kong 8000, Business 8080, IAM 8081, Radar 8082, Messaging 8083, Reservation 8084.
# IAM always listens on 8081: server.port is fixed in application.yaml (there is no SERVER_PORT variable).
# The gateway (foodly-infra) forwards /iam to that port.
